#include <windows.h>
#include <commctrl.h>
#include "version.h"

// Shown in the executable's Properties > Details tab.
VS_VERSION_INFO VERSIONINFO
FILEVERSION MELVOR_SWITCH_VERSION_NUMBERS
PRODUCTVERSION MELVOR_SWITCH_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "vani5h"
            VALUE "FileDescription", "Melvor Companion - unofficial Melvor Idle 2 companion"
            VALUE "FileVersion", MELVOR_SWITCH_VERSION_TEXT
            VALUE "InternalName", "MelvorCompanion"
            VALUE "LegalCopyright", "Copyright (c) 2026 vani5h. MIT License. Unofficial; not affiliated with Games by Malcs."
            VALUE "OriginalFilename", "MelvorCompanion.exe"
            VALUE "ProductName", "Melvor Companion"
            VALUE "ProductVersion", MELVOR_SWITCH_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

101 ICON "switch-soft-teal-awake.ico"
102 ICON "switch-soft-teal-sleep.ico"
103 ICON "switch-ice-blue-awake.ico"
104 ICON "switch-ice-blue-sleep.ico"
105 ICON "switch-lavender-awake.ico"
106 ICON "switch-lavender-sleep.ico"
107 ICON "switch-state-colors-awake.ico"
108 ICON "switch-state-colors-sleep.ico"
109 ICON "switch-neutral-missing.ico"
110 ICON "switch-neutral-dead.ico"

// Detailed Summary window (src/summary.cpp). Everything but the Close button is painted.
205 DIALOGEX 0,0,200,200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "Detailed Summary - Melvor Companion"
FONT 10, "Segoe UI"
BEGIN
    CONTROL "Close", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 0,0,10,10
END

// Goals window (src/goals.cpp). Positions are placeholders: the code lays out and paints
// every control, so only IDs, styles, and tab order (top to bottom) matter here.
204 DIALOGEX 0,0,240,320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "Goals - Melvor Companion"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "", 506, 0,0,10,10, SS_NOPREFIX
    CONTROL "", 501, WC_LISTVIEW, WS_TABSTOP | LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_EDITLABELS, 0,0,10,10
    EDITTEXT 503, 0,0,10,10, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
    CONTROL "Add", 504, "Button", BS_OWNERDRAW | WS_TABSTOP, 0,0,10,10
    CONTROL "Clear completed", 508, "Button", BS_OWNERDRAW | WS_TABSTOP, 0,0,10,10
    LTEXT "", 502, 0,0,10,10, SS_NOPREFIX
    CONTROL "Done", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 0,0,10,10
END


